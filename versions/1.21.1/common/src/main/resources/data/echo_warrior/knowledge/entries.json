      "illustration_binding": "high",
      "illustrations": [{"type": "item", "resource": "echo_warrior:cat_bell_fish_charm_accessory"}],
      "evidence_type": "historical_paintings_and_museum_catalogues",
      "source_notes": "Historical Chinese paintings treat cats as closely observed household companions and auspicious motifs. The accessory's jade, bell and fish combination is a project design rather than a reconstruction of either painting.",
      "sources": [{"kind": "museum", "title": "Anonymous Song dynasty, Cats at Play", "url": "https://digitalarchive.npm.gov.tw/Collection/Detail/1361?dep=P"}, {"kind": "museum", "title": "Ming dynasty Cat and Butterfly", "url": "https://www.dpm.org.cn/collection/paint/370694.html"}]
    },
    {
      "id": "china_guan_yu_afterlife", "culture": "chinese", "order": 8,
      "title_key": "knowledge.echo_warrior.entry.china_guan_yu_afterlife.title",
      "body_key": "knowledge.echo_warrior.entry.china_guan_yu_afterlife.body",
      "illustration_binding": "high",
      "illustrations": [{"type": "item", "resource": "echo_warrior:twin_oath_badge_accessory"}],
      "evidence_type": "surviving_western_zhou_jade_and_museum_catalogue",
      "source_notes": "Fish-shaped jades are historically documented ornaments. The paired-fish composition and oath mechanics are project designs rather than a reconstruction of this single object.",
      "sources": [{"kind": "museum", "title": "Western Zhou jade fish pendant", "url": "https://www.chnmuseum.cn/zp/zpml/201812/t20181218_24500.shtml"}]
    },

